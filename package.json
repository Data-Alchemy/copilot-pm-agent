{
  "name": "copilot-pm-agent",
  "displayName": "Copilot PM Agent",
  "description": "VS Code Agent that lets you open, estimate, and assign Jira & Azure DevOps work items via chat",
  "version": "2.5.1",
  "publisher": "DataAlchemy",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "jira",
    "azure devops",
    "agent",
    "project management",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "pm-agent.main",
        "name": "pm",
        "fullName": "PM Agent",
        "description": "Manage Jira and Azure DevOps work items from VS Code",
        "isSticky": true,
        "commands": [
          {
            "name": "agent",
            "description": "Agentic mode \u2014 describe a multi-step task in plain language and let PM Agent plan & act"
          },
          {
            "name": "list",
            "description": "List work items assigned to the default user"
          },
          {
            "name": "open",
            "description": "Open a work item by key (e.g. #1234 or ENG-42)"
          },
          {
            "name": "create",
            "description": "Create a story, task or bug with AI-assisted structuring"
          },
          {
            "name": "comment",
            "description": "Add a comment to a work item"
          },
          {
            "name": "status",
            "description": "Transition a work item to a new status"
          },
          {
            "name": "attach",
            "description": "Upload a file attachment to a work item"
          },
          {
            "name": "summary",
            "description": "Summarise your workload or a single work item"
          },
          {
            "name": "estimate",
            "description": "Set story points or effort on a work item"
          },
          {
            "name": "assign",
            "description": "Assign a work item to a team member"
          },
          {
            "name": "sprint",
            "description": "View the current active sprint"
          },
          {
            "name": "setuser",
            "description": "Set the default user for all actions"
          },
          {
            "name": "setupai",
            "description": "Configure AI provider (GitHub Copilot, Anthropic, OpenAI, Azure)"
          },
          {
            "name": "debug",
            "description": "Run connectivity diagnostics"
          },
          {
            "name": "parent",
            "description": "Set or change the parent item for a task or bug (Azure DevOps)"
          },
          {
            "name": "move",
            "description": "Move a work item to a different sprint or iteration"
          },
          {
            "name": "migrate",
            "description": "Copy a work item from one platform to the other (ADO \u2194 Jira)"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "pm-agent.openChat",
        "title": "PM Agent: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "pm-agent.configurePlatform",
        "title": "PM Agent: Configure Platform",
        "icon": "$(settings)"
      },
      {
        "command": "pm-agent.configureAi",
        "title": "PM Agent: Configure AI Provider",
        "icon": "$(sparkle)"
      },
      {
        "command": "pm-agent.setDefaultUser",
        "title": "PM Agent: Set Default User",
        "icon": "$(person)"
      },
      {
        "command": "pm-agent.openWorkItemPanel",
        "title": "PM Agent: Open Work Item",
        "icon": "$(output)"
      },
      {
        "command": "pm-agent.list",
        "title": "PM Agent: List My Work Items"
      },
      {
        "command": "pm-agent.open",
        "title": "PM Agent: Open Work Item"
      },
      {
        "command": "pm-agent.create",
        "title": "PM Agent: Create Work Item"
      },
      {
        "command": "pm-agent.comment",
        "title": "PM Agent: Add Comment"
      },
      {
        "command": "pm-agent.status",
        "title": "PM Agent: Change Status"
      },
      {
        "command": "pm-agent.assign",
        "title": "PM Agent: Assign Work Item"
      },
      {
        "command": "pm-agent.estimate",
        "title": "PM Agent: Set Story Points"
      },
      {
        "command": "pm-agent.move",
        "title": "PM Agent: Move to Sprint"
      },
      {
        "command": "pm-agent.parent",
        "title": "PM Agent: Set Parent"
      },
      {
        "command": "pm-agent.sprint",
        "title": "PM Agent: Show Current Sprint"
      },
      {
        "command": "pm-agent.migrate",
        "title": "PM Agent: Migrate Ticket (ADO \u2194 Jira)"
      },
      {
        "command": "pm-agent.debug",
        "title": "PM Agent: Debug Connection"
      }
    ],
    "configuration": {
      "title": "PM Agent",
      "properties": {
        "pmAgent.platform": {
          "type": "string",
          "enum": [
            "jira",
            "azuredevops",
            "github"
          ],
          "default": "jira",
          "description": "Which platform to connect to"
        },
        "pmAgent.jira.baseUrl": {
          "type": "string",
          "description": "Jira base URL (e.g. https://yourorg.atlassian.net)"
        },
        "pmAgent.jira.email": {
          "type": "string",
          "description": "Jira account email"
        },
        "pmAgent.jira.defaultProject": {
          "type": "string",
          "description": "Default Jira project key (e.g. ENG)"
        },
        "pmAgent.azureDevOps.orgUrl": {
          "type": "string",
          "description": "Azure DevOps org URL (e.g. https://dev.azure.com/yourorg)"
        },
        "pmAgent.azureDevOps.project": {
          "type": "string",
          "description": "Azure DevOps project name"
        },
        "pmAgent.github.owner": {
          "type": "string",
          "description": "GitHub owner (organization or username)"
        },
        "pmAgent.github.repo": {
          "type": "string",
          "description": "GitHub repository name"
        },
        "pmAgent.github.projectNumber": {
          "type": "number",
          "description": "GitHub Projects v2 number (optional \u2014 for project board integration)"
        },
        "pmAgent.ai.provider": {
          "type": "string",
          "enum": [
            "copilot",
            "anthropic",
            "openai",
            "azure-openai",
            "none"
          ],
          "default": "copilot",
          "description": "AI provider for ticket enhancement. copilot = uses GitHub Copilot (no extra key needed)."
        },
        "pmAgent.ai.azureUrl": {
          "type": "string",
          "description": "Azure OpenAI full deployment endpoint URL"
        },
        "pmAgent.ai.model": {
          "type": "string",
          "description": "Override default AI model (optional)"
        }
      }
    },
    "icons": {},
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pm-agent-sidebar",
          "title": "PM Agent",
          "icon": "media/pm-agent-icon.svg"
        }
      ]
    },
    "views": {
      "pm-agent-sidebar": [
        {
          "type": "webview",
          "id": "pm-agent.workItemView",
          "name": "Chat"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "pm_listWorkItems",
        "displayName": "List/Search Work Items",
        "modelDescription": "Search or list work items (issues/tickets) in the configured Jira, Azure DevOps, or GitHub project. Returns a page of items with a nextCursor for paging. Use assigneeId='@me' for the current default user; status='open' for not-done items.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pmlistWorkItems",
        "tags": [
          "pm-agent",
          "jira",
          "azure-devops",
          "github",
          "work-items"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "assigneeId": {
              "type": "string",
              "description": "Account ID or email to filter by, or '@me' for the current user"
            },
            "status": {
              "type": "string",
              "description": "'open' for not-done, or an exact status name like 'In Progress'"
            },
            "type": {
              "type": "string",
              "enum": [
                "story",
                "task",
                "bug",
                "epic",
                "subtask",
                "feature",
                "testcase"
              ],
              "description": "Filter by work item type"
            },
            "text": {
              "type": "string",
              "description": "Free-text search across title/description"
            },
            "projectKey": {
              "type": "string",
              "description": "Override the default project"
            },
            "sprintId": {
              "type": "string",
              "description": "Filter to a sprint/iteration id"
            },
            "maxResults": {
              "type": "number",
              "description": "Page size (default 50)"
            },
            "pageCursor": {
              "type": "string",
              "description": "Cursor from a previous call's nextCursor to fetch the next page"
            }
          }
        }
      },
      {
        "name": "pm_getWorkItem",
        "displayName": "Get Work Item",
        "modelDescription": "Fetch a single work item by key (e.g. 'ENG-42', '#1234') including description, and optionally its comments and child items.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pmgetWorkItem",
        "tags": [
          "pm-agent",
          "jira",
          "azure-devops",
          "github",
          "work-items"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "Work item key/id, e.g. ENG-42 or #1234"
            },
            "includeComments": {
              "type": "boolean"
            },
            "includeChildren": {
              "type": "boolean"
            }
          },
          "required": [
            "key"
          ]
        }
      },
      {
        "name": "pm_createWorkItem",
        "displayName": "Create Work Item",
        "modelDescription": "Create a work item. Provide type and title at minimum. For Jira projects with mandatory custom fields, pass them in customFields; if a required field is missing the tool returns error='missing_required_fields' listing the field keys so you can re-invoke with them.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pmcreateWorkItem",
        "tags": [
          "pm-agent",
          "jira",
          "azure-devops",
          "github",
          "work-items"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "story",
                "task",
                "bug",
                "epic",
                "subtask",
                "feature",
                "testcase"
              ]
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "acceptanceCriteria": {
              "type": "string"
            },
            "assigneeId": {
              "type": "string"
            },
            "storyPoints": {
              "type": "number"
            },
            "priority": {
              "type": "string"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sprintId": {
              "type": "string"
            },
            "parentId": {
              "type": "string",
              "description": "Parent work item key for sub-tasks/children"
            },
            "projectKey": {
              "type": "string",
              "description": "Target project (defaults to configured project)"
            },
            "rawTypeName": {
              "type": "string",
              "description": "Exact platform type name; bypasses type mapping"
            },
            "customFields": {
              "type": "object",
              "description": "Map of fieldKey->value for required custom fields",
              "additionalProperties": true
            }
          },
          "required": [
            "type",
            "title"
          ]
        }
      },
      {
        "name": "pm_updateWorkItem",
        "displayName": "Update Work Item",
        "modelDescription": "Update fields on an existing work item. Setting 'status' transitions it; setting 'assigneeId' reassigns it.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pmupdateWorkItem",
        "tags": [
          "pm-agent",
          "jira",
          "azure-devops",
          "github",
          "work-items"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "storyPoints": {
              "type": "number"
            },
            "priority": {
              "type": "string"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "type": "string"
            },
            "assigneeId": {
              "type": "string"
            }
          },
          "required": [
            "key"
          ]
        }
      },
      {
        "name": "pm_transitionWorkItem",
        "displayName": "Transition Work Item Status",
        "modelDescription": "Move a work item to a new status/state (e.g. 'In Progress', 'Done'). Returns the updated item or the list of available transitions if the target is invalid.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pmtransitionWorkItem",
        "tags": [
          "pm-agent",
          "jira",
          "azure-devops",
          "github",
          "work-items"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          },
          "required": [
            "key",
            "status"
          ]
        }
      },
      {
        "name": "pm_addComment",
        "displayName": "Add Comment",
        "modelDescription": "Add a comment to a work item.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pmaddComment",
        "tags": [
          "pm-agent",
          "jira",
          "azure-devops",
          "github",
          "work-items"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "body": {
              "type": "string"
            }
          },
          "required": [
            "key",
            "body"
          ]
        }
      },
      {
        "name": "pm_listProjectMembers",
        "displayName": "List Project Members",
        "modelDescription": "List assignable members of a project (id, display name, email). Use to resolve a person's name to an assigneeId before creating/assigning.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pmlistProjectMembers",
        "tags": [
          "pm-agent",
          "jira",
          "azure-devops",
          "github",
          "work-items"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectKey": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "pm_getSprints",
        "displayName": "Get Sprints",
        "modelDescription": "Get the active sprint, or all sprints when all=true.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pmgetSprints",
        "tags": [
          "pm-agent",
          "jira",
          "azure-devops",
          "github",
          "work-items"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectKey": {
              "type": "string"
            },
            "all": {
              "type": "boolean"
            }
          }
        }
      },
      {
        "name": "pm_listProjects",
        "displayName": "List Projects",
        "modelDescription": "List the projects available with the configured credentials.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pmlistProjects",
        "tags": [
          "pm-agent",
          "jira",
          "azure-devops",
          "github",
          "work-items"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "pm_getWorkItemTypes",
        "displayName": "Get Work Item Types",
        "modelDescription": "List the work item / issue type names available in a project. Useful before creating to pick a valid rawTypeName.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "pmgetWorkItemTypes",
        "tags": [
          "pm-agent",
          "jira",
          "azure-devops",
          "github",
          "work-items"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectKey": {
              "type": "string"
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "jest --verbose",
    "package": "vsce package",
    "inject-wizard": "node scripts/inject-wizard.js",
    "vscode:prepublish": "npm run compile && npm run inject-wizard"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.26.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.4.0"
  },
  "author": {
    "name": "Sebastian Hansen",
    "url": "https://github.com/Data-Alchemy"
  },
  "homepage": "https://github.com/Data-Alchemy/copilot-pm-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/Data-Alchemy/copilot-pm-agent"
  },
  "bugs": {
    "url": "https://github.com/Data-Alchemy/copilot-pm-agent/issues"
  },
  "icon": "media/pm-agent-icon.png"
}